#!/usr/bin/env bash
# Install estate-health onto paths.bin and the hourly job. Idempotent; --dry-run changes nothing.
# shellcheck source=../../lib/estate.sh
. "$ESTATE_ROOT/lib/estate.sh"
# shellcheck source=common.sh
. "$ESTATE_MODULE_DIR/common.sh"

if [ "$ESTATE_DRY_RUN" = 1 ]; then
  if [ "$(readlink "$BIN/estate-health" 2>/dev/null)" = "$ESTATE_MODULE_DIR/estate-health" ]; then
    echo "unchanged: $BIN/estate-health" >&2
  else
    echo "would link: $BIN/estate-health -> $ESTATE_MODULE_DIR/estate-health" >&2
  fi
else
  mkdir -p "$BIN"
  ln -sfn "$ESTATE_MODULE_DIR/estate-health" "$BIN/estate-health"
fi

if [ "$ESTATE_PLATFORM" = mac ]; then
  pin_python   # launchd's PATH has no python3 worth using; the job names its interpreter
  [ "$ESTATE_DRY_RUN" = 1 ] || mkdir -p "$(dirname "$PLIST")"
  changed=1
  if [ -f "$PLIST" ] && rendered_pinned health.plist | cmp -s - "$PLIST"; then
    changed=0
  fi
  render_pinned health.plist "$PLIST"
  if [ "$changed" = 1 ] || ! launchctl print "$DOMAIN/$LABEL" >/dev/null 2>&1; then
    run launchctl bootout "$DOMAIN/$LABEL" 2>/dev/null || true
    run launchctl bootstrap "$DOMAIN" "$PLIST"
  fi
else
  [ "$ESTATE_DRY_RUN" = 1 ] || mkdir -p "$UNIT_DIR"
  render health.service "$SERVICE"
  render health.timer "$TIMER_FILE"
  run systemctl --user daemon-reload
  run systemctl --user enable --now "$TIMER"
fi

# One collection now, so the check has a report to find and the person sees one.
if [ "$ESTATE_DRY_RUN" = 1 ]; then
  echo "would run: estate-health --quiet" >&2
else
  "${PY:-python3}" "$ESTATE_MODULE_DIR/estate-health" --quiet || true
fi
say "installed: hourly health report; read it with: estate-health"
